# Скопируйте в .env (для запуска на своём компьютере) или задайте в панели хостинга.

# Пароль для входа в интерфейс. Обязателен, если подключён счёт биржи;
# для реального счёта Binance — не короче 10 символов.
ACCESS_PASSWORD=придумайте-длинный-пароль

# ---------- Счета ----------
# Счёт выбирается в шапке интерфейса и запоминается.
# Виртуальный счёт есть всегда: ненастоящие деньги, реальные котировки биржи.
PAPER_START_CASH=10000
# Максимальная сумма одного ордера на виртуальном счёте, USDT
MAX_ORDER_USD=3000

# Счёт Binance (необязательно): появится в списке, когда заданы ключи.
# live — ваш настоящий счёт и настоящие деньги; demo — демо-торговля Binance
BINANCE_ENV=live
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Максимальная сумма одного ордера на счёте Binance, USDT (для live по умолчанию 200)
BINANCE_MAX_ORDER_USD=200

# Откуда брать котировки: binance (по умолчанию) или bybit
QUOTES=binance
# swap — бессрочные фьючерсы USDT-M (можно шортить), spot — спот (только покупки)
MARKET_TYPE=swap
# Плечо для фьючерсов (1–5)
LEVERAGE=1

# Монеты и таймфрейм свечей
COINS=BTC,ETH,SOL,BNB,XRP,DOGE
TIMEFRAME=5m
# Как часто Рустам делает сводку (секунды) и как часто обновлять цены и новости
SCAN_SECONDS=60
TICKER_SECONDS=5
NEWS_SECONDS=180

# Claude API для разбора новостей, планёрки и разговора с агентами (необязательно)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_MODEL_FAST=claude-haiku-5-5

# Часовой пояс офиса (смена торгового дня)
OFFICE_TZ=Asia/Tashkent
# Папка для сохранения состояния (на хостинге — путь к постоянному диску)
DATA_DIR=./data

# Старый способ (по-прежнему работает): демо-счёт или тестовая сеть Bybit
# EXCHANGE=bybit
# EXCHANGE_ENV=demo
# EXCHANGE_API_KEY=
# EXCHANGE_API_SECRET=
