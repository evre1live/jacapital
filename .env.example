# Скопируйте в .env (для запуска на своём компьютере) или задайте в панели хостинга.

# Пароль для входа в интерфейс. Обязателен для режима exchange.
ACCESS_PASSWORD=придумайте-длинный-пароль

# paper — виртуальный счёт на реальных ценах, ключи биржи не нужны
# exchange — настоящие ордера на демо-счёте или в тестовой сети биржи
TRADING_MODE=paper

# Биржа: bybit или binance (mock — имитация для проверки без интернета)
EXCHANGE=bybit
# demo — демо-торговля на реальных ценах (рекомендуется), testnet — тестовая сеть (только Bybit для фьючерсов)
EXCHANGE_ENV=demo
# swap — бессрочные фьючерсы USDT (можно шортить), spot — спот (только покупки)
MARKET_TYPE=swap
# Ключи API от демо-счёта / тестовой сети (только для TRADING_MODE=exchange)
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
# Плечо для фьючерсов (1–5)
LEVERAGE=1
# Максимальная сумма одного ордера в USDT
MAX_ORDER_USD=3000

# Монеты и таймфрейм свечей
COINS=BTC,ETH,SOL,BNB,XRP,DOGE
TIMEFRAME=5m
# Как часто Ника делает сводку (секунды) и как часто обновлять цены и новости
SCAN_SECONDS=60
TICKER_SECONDS=5
NEWS_SECONDS=180

# Claude API для разбора новостей, планёрки и разговора с агентами (необязательно)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_MODEL_FAST=claude-haiku-5-5

# Часовой пояс офиса (смена торгового дня) и стартовый виртуальный капитал
OFFICE_TZ=Asia/Tashkent
PAPER_START_CASH=10000
# Папка для сохранения состояния (на хостинге — путь к постоянному диску)
DATA_DIR=./data
